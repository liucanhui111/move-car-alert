<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/settings_title"
            app:titleTextColor="@color/on_primary"
            app:navigationIconTint="@color/on_primary" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ============ 提醒规则 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Setting.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="提醒规则" />

                    <include android:id="@+id/row_interval" layout="@layout/item_setting_row" />
                    <include android:id="@+id/row_max_count" layout="@layout/item_setting_row" />
                    <include android:id="@+id/row_countdown" layout="@layout/item_setting_row" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 震动参数 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Setting.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="震动参数（零音频，仅震动）" />

                    <include android:id="@+id/row_vib_duration" layout="@layout/item_setting_row" />
                    <include android:id="@+id/row_vib_gap" layout="@layout/item_setting_row" />
                    <include android:id="@+id/row_vib_repeat" layout="@layout/item_setting_row" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test_vibrate"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="测试震动（按当前参数）"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_vibrate"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 短信监控列表 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Text.Setting.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="短信监控（号码 / 联系人名）" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_keyword"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/on_primary_container"
                            app:contentDescription="添加监控" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="收到发件人（通知标题）包含以下关键词的系统短信时，立即触发告警"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <LinearLayout
                        android:id="@+id/keyword_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ APP 监控列表 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Text.Setting.Section"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="APP 推送监控" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_add_app"
                            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/ic_add"
                            app:iconTint="@color/on_primary_container"
                            app:contentDescription="添加监控APP" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="收到以下 APP 的通知推送时，立即触发告警"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <LinearLayout
                        android:id="@+id/app_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 弹窗图片 ============ -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Card.Setting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Text.Setting.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="弹窗提醒图片" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="可上传本地图片，作为全屏告警弹窗的展示图"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/outline">

                        <ImageView
                            android:id="@+id/image_preview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:contentDescription="弹窗图片预览"
                            android:src="@drawable/ic_car_big" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_pick_image"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="选择图片"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_image"
                            app:iconGravity="textStart" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_reset_image"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="恢复默认"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
